# Use these only in a server-side runtime (for example, a Vercel API route or
# Cloudflare Worker). Never expose secret values in browser JavaScript.

# Server-side OpenAI configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.2-astra

# Supabase public client configuration (safe to expose only through a vetted
# public runtime configuration mechanism; do not add the service-role key to a client)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase administration key
SUPABASE_SERVICE_ROLE_KEY=

# Optional protection for authenticated server routes
APP_ORIGIN=
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=20
MAX_CAPTURE_BYTES=8388608
